#!/bin/bash
# .app 더블클릭 → Terminal에서 cleaner 실행(Ctrl+C로 종료 가능).
# 앱 번들 위치 기준으로 프로젝트 폴더(.command) 탐색, 못 찾으면 절대경로 폴백.
HERE="$(cd "$(dirname "$0")" && pwd)"            # .../DiskCleaner.app/Contents/MacOS
PROJ="$(cd "$HERE/../../.." && pwd)"             # .../mac-disk-cleaner
CMD="$PROJ/DiskCleaner.command"
if [ ! -f "$CMD" ]; then
    CMD="/Users/kim_youngmin/Documents/IdeaPlaning/mac-disk-cleaner/DiskCleaner.command"
fi
open "$CMD"
